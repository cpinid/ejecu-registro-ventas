# Aplicación
API_ENV=dev
API_PORT=8080
FRONTEND_URL=http://localhost:5190
TZ=America/Santiago

# PostgreSQL
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgres://registro_venta:replace-with-local-password@postgres:5432/registro_venta?sslmode=disable

# Identidad
AUTH_JWKS_URL=http://replace-with-identity-service/.well-known/jwks.json