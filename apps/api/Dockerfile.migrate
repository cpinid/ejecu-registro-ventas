# syntax=docker/dockerfile:1.7
ARG ALPINE_IMAGE
FROM --platform=$BUILDPLATFORM golang:1.26.5-alpine3.23@sha256:622e56dbc11a8cfe87cafa2331e9a201877271cbff918af53d3be315f3da88cc AS build
ARG TARGETOS TARGETARCH
RUN --mount=type=cache,target=/go/pkg/mod CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH GOBIN=/out go install github.com/pressly/goose/v3/cmd/goose@v3.24.1
FROM $ALPINE_IMAGE
WORKDIR /app
COPY --from=build --chown=65532:65532 /out/goose /usr/local/bin/goose
COPY --chown=65532:65532 apps/api/db/migrations /app/db/migrations
USER 65532:65532
ENTRYPOINT ["/bin/sh", "-c", "exec goose -dir /app/db/migrations postgres \"$DATABASE_URL\" up"]
