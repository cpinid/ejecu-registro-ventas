    "react-hook-form": "catalog:",
    "react-router": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@vitejs/plugin-react": "6.0.4",
    "msw": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "openapi-typescript": "catalog:",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0"
  }
